# Mặc định: SQLite riêng ở BE/.local/foodorder.db; không cần sửa để chạy local.
# DATABASE_URL=sqlite+aiosqlite:///C:/duong-dan/FoodOrder/BE/.local/foodorder.db
SEED_MENU=1
# Điểm/lượt đánh giá mẫu chỉ dùng hiển thị; 0 để ẩn. Không tạo đánh giá thật.
DEMO_RATINGS=1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# Không có key: trợ lý gợi ý thực đơn chạy local và hiển thị rõ chế độ.
# AI hội thoại: chọn openai hoặc gemini, khai báo model tài khoản của bạn có quyền dùng.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
